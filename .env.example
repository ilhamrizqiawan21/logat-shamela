# Konfigurasi backend. Salin menjadi .env, lalu mulai ulang aplikasi.
# Default memakai Ollama lokal; tidak memerlukan API key.
AI_PROVIDER=ollama

# Pastikan model tersedia di `ollama list`.
# Jika belum tersedia: ollama pull qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=220
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT=90
OLLAMA_STARTUP_TIMEOUT=15
OLLAMA_TEMPERATURE=0.1

# Alternatif Gemini: ubah AI_PROVIDER=gemini dan isi GEMINI_API_KEY.
# Jangan memakai awalan VITE_ untuk API key.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Batas waktu dalam detik (5–90), batas token jawaban (128–8192).
GEMINI_TIMEOUT=45
GEMINI_MAX_OUTPUT_TOKENS=500

# Opsional: isi jika lokasi Syamilah tidak terdeteksi otomatis.
# SHAMELA_INSTALL_ROOT=/path/ke/shamela
